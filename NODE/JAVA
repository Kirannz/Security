### 18. Create Jenkinsfile

```bash
nano Jenkinsfile
```

Paste:

```groovy
pipeline {
    agent any

    stages {

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t yourdockerhubusername/java-k8s-app:v1 .'
            }
        }

        stage('Docker Push') {
            steps {
                sh 'docker push yourdockerhubusername/java-k8s-app:v1'
            }
        }

        stage('Deploy Kubernetes') {
            steps {
                sh 'kubectl create deployment java-app --image=yourdockerhubusername/java-k8s-app:v1 || true'
            }
        }

    }
}
```

